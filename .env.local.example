# Copia questo file in .env.local e compila con i valori del tuo progetto Firebase
# (Firebase Console → Project Settings → Your apps → Config)

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=gymlog-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gymlog-xxxxx
VITE_FIREBASE_STORAGE_BUCKET=gymlog-xxxxx.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Chiave Claude (già configurata)
VITE_CLAUDE_API_KEY=sk-ant-...
